# PostgreSQL connection string from your database provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Midtrans: use sandbox first. Never expose Server Key in NEXT_PUBLIC variables.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
APP_URL="http://localhost:3000"

# Admin API protection: use a long random secret (32+ characters).
ADMIN_API_TOKEN=""

# Supplier values MUST come from the official VIP Reseller API documentation.
# Do not guess endpoint paths, request fields, or signatures.
VIP_RESELLER_API_BASE_URL=""
VIP_RESELLER_API_KEY=""
VIP_RESELLER_API_SECRET=""
VIP_RESELLER_CREATE_ORDER_PATH=""
VIP_RESELLER_CHECK_ORDER_PATH=""
VIP_RESELLER_PRODUCT_LIST_PATH=""
